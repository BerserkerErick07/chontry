# Copie este archivo como .env (que está en .gitignore) y complete los valores.
# NUNCA suba el .env al repositorio. Ver docs/manual_instalacion.md.

# --- Consola (cada persona tiene SU PROPIO login de base de datos ct_...) ------------------
# En Neon/servidor remoto son obligatorios sslmode=verify-full y channel_binding=require;
# comun/db.py rechaza cualquier otra cosa y también rechaza el rol dueño de la BD.
CHONTRY_DB_URL=postgresql://ct_USUARIO:CONTRASENA@HOST/neondb?sslmode=verify-full&channel_binding=require

# --- Sensor (solo en el equipo conectado al puerto SPAN) ------------------------------------
# Si el sensor y la consola están en el mismo equipo, use una variable aparte para el sensor:
# CHONTRY_DB_URL_SENSOR=postgresql://ct_sensor01:CONTRASENA@HOST/neondb?sslmode=verify-full&channel_binding=require
# CHONTRY_SENSOR_ID=uuid-que-muestra-"herramientas.admin registrar-sensor"

# --- Clave maestra AES-256 (evidencias, segundo factor y buffer del sensor) -----------------
# La genera el administrador:  python -m herramientas.admin generar-clave-maestra
# Debe ser LA MISMA en el sensor y en todas las consolas. También puede ir en el keyring.
CHONTRY_CLAVE_MAESTRA=

# --- Solo para el administrador de la BD (migraciones, crear logins y usuarios) -------------
# No lo deje en equipos de operación; la herramienta lo pide sin mostrarlo si falta.
# CHONTRY_DB_URL_ADMIN=postgresql://neondb_owner:CONTRASENA@HOST/neondb?sslmode=verify-full&channel_binding=require
